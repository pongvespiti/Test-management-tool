# ---------------------------------------------------------------------------------------------
# TMT — Test Management Tool · environment settings
# Copy to `.env` and adjust. Every value has a safe default for local development except
# DATABASE_URL. Never commit the real `.env` (it is git-ignored).
# Used by: apps/api (NestJS), packages/database (Prisma CLI), docker-compose.yml.
# ---------------------------------------------------------------------------------------------

# --- Database (PostgreSQL 16+) -----------------------------------------------------------------
DATABASE_URL=postgresql://tmt:tmt@localhost:5432/tmt?schema=public
# Separate database for the API e2e tests (dropped and re-created by the tests!)
TEST_DATABASE_URL=postgresql://tmt:tmt@localhost:5432/tmt_test?schema=public
DB_POOL_MAX=10
# Only for docker-compose.yml (the `db` service)
POSTGRES_USER=tmt
POSTGRES_PASSWORD=tmt
POSTGRES_DB=tmt

# --- API server ----------------------------------------------------------------------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
# Browser origins allowed to send state-changing requests (comma separated) — the web app URL
WEB_ORIGINS=http://localhost:3000
# External URL of the web app (used in links, e.g. Jira issues). Optional.
PUBLIC_URL=http://localhost:3000
# Set to true when the API runs behind a reverse proxy (X-Forwarded-* headers)
TRUST_PROXY=false
# Uploaded files (attachments, report templates, import files) and generated secrets
DATA_DIR=./data
MAX_UPLOAD_MB=25
LOG_LEVEL=info
# Swagger UI at /api/docs and the OpenAPI JSON at /api/v1/openapi.json
SWAGGER_ENABLED=true

# --- Sessions & sign-in --------------------------------------------------------------------
SESSION_COOKIE_NAME=tmt_session
# true when the site is served over HTTPS (cookie gets the Secure flag)
COOKIE_SECURE=false
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
LOGIN_RATE_LIMIT_PER_MIN=20
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15
# First administrator, created at start-up when the database has no user yet; the password must
# be changed at first sign-in. Leave the password empty to generate a one-time password that is
# printed in the API log.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# --- Demo data (`pnpm db:seed`) ----------------------------------------------------------------
# Password of the demo accounts demo.lead / demo.tester / demo.viewer (at least 8 characters).
# Empty: a random password is generated and printed once by the seed.
SEED_USER_PASSWORD=

# --- Domain defaults -----------------------------------------------------------------------
# Document number pattern of new projects. Tokens: {YY} {YYYY} {MM} {SEQ}
# Replace TEAM with your own department or document code. Each project can change its pattern
# later under Settings → General.
DEFAULT_DOC_NO_PATTERN={YY}TR-TEAM-{MM}-{SEQ}
# Time zone of dates printed in reports (IANA name)
REPORT_TIMEZONE=Asia/Bangkok
# Key material (>= 32 characters) that encrypts integration secrets (e.g. Jira tokens).
# Generated into DATA_DIR on first start when empty — set it explicitly in production.
APP_SECRET=

# --- Web app ---------------------------------------------------------------------------------
# The Next.js app has its own settings in apps/web/.env.example (API_URL, SESSION_COOKIE_NAME).
