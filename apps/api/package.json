{
  "name": "@tmt/api",
  "version": "2.0.0",
  "private": true,
  "description": "TMT REST API \u2014 NestJS (ESM) on PostgreSQL via Prisma.",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
    "seed": "nest build && node dist/scripts/seed.js",
    "clean": "rm -rf dist .turbo",
    "test:cov": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config jest.e2e.config.js",
    "lint": "oxlint -c ../../.oxlintrc.json src test"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@tmt/database": "workspace:*",
    "@tmt/excel": "workspace:*",
    "@tmt/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "5.11.2",
    "helmet": "^8.1.0",
    "jszip": "^3.10.2",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@standard-schema/spec": "^1.1.0",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@tmt/jest-config": "workspace:*",
    "@tmt/tsconfig": "workspace:*",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "jest": "30.5.2",
    "jest-mock-extended": "4.0.2",
    "pg": "^8.16.3",
    "pino-pretty": "^13.1.0",
    "supertest": "^7.1.4",
    "typescript": "~6.0.2"
  }
}
