# Web app (Next.js) — copy to `.env.local` for development (`next dev` loads it).
# Where the NestJS API listens; `/api/*` requests are forwarded there at runtime (src/proxy.ts).
API_URL=http://localhost:4000
# Must match the API's SESSION_COOKIE_NAME (signed-out visitors are redirected to /login early).
SESSION_COOKIE_NAME=tmt_session
# The server port comes from the PORT environment variable (default 3000), e.g. `PORT=8080 pnpm dev`.
